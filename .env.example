# Copy to .env and adjust if needed. Defaults below are fine for local development.

POSTGRES_USER=aquatrack
POSTGRES_PASSWORD=aquatrack
POSTGRES_DB=aquatrack
# Host-side port for Postgres (container always listens on 5432 internally). Off the default 5432
# because that's frequently already taken by a locally-installed Postgres.
POSTGRES_HOST_PORT=5433

# Used to sign JWTs (HS256, so this must be at least 32 characters / 256 bits — a shorter value
# throws at first login attempt, not at startup). Change this for anything beyond local dev.
JWT_SECRET=dev-only-secret-change-me-please-32-chars-min

# Base URL the frontend uses to reach the backend API (baked in at frontend build time).
VITE_API_URL=http://localhost:5000
