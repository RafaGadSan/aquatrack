# Copy to .env and adjust if needed. Defaults below are fine for local development.

POSTGRES_USER=aquatrack
POSTGRES_PASSWORD=aquatrack
POSTGRES_DB=aquatrack

# Used to sign JWTs. Change this for anything beyond local dev.
JWT_SECRET=dev-only-secret-change-me

# Base URL the frontend uses to reach the backend API (baked in at frontend build time).
VITE_API_URL=http://localhost:5000
